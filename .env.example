# ============================================================
# Basic setup
# 기본 설정
# ============================================================

# Discord 봇 토큰입니다. 실제 토큰을 여기에 넣으세요.
# Discord bot token. Put your real bot token here.
DISCORD_TOKEN=put-your-bot-token-here

# 슬래시 명령어를 빠르게 동기화할 테스트 서버 ID입니다.
# 비우면 전역 동기화를 사용합니다.
# Test guild/server ID for faster slash-command sync.
# Leave empty to sync globally.
GUILD_ID=123456789012345678

# FFmpeg 실행 파일 경로입니다.
# 비우면 시스템 FFmpeg 또는 imageio-ffmpeg 번들을 사용합니다.
# Path to the FFmpeg executable.
# Leave empty to use system FFmpeg or bundled imageio-ffmpeg.
FFMPEG_PATH=

# /normalizer가 켜져 있을 때 쓰는 FFmpeg 오디오 필터입니다.
# FFmpeg audio filter used when /normalizer is enabled.
NORMALIZER_FILTER=dynaudnorm=f=150:g=15

# ============================================================
# Vocal separation
# 보컬 분리
# ============================================================

# 보컬/반주 분리 백엔드입니다.
# 기본 auto는 Roformer audio-separator를 사용합니다.
#
# Vocal/instrumental separator backend.
# Default auto uses Roformer audio-separator.
VOCAL_SEPARATOR_BACKEND=auto

# audio-separator에서 사용할 Roformer 보컬 분리 모델 파일명입니다.
# Roformer vocal separation model filename used by audio-separator.
VOCAL_SEPARATOR_MODEL=mel_band_roformer_kim_ft_unwa.ckpt


# ============================================================
# Advanced settings
# 고급 설정
#
# 아래 값들은 기본값이 코드에 이미 들어 있습니다.
# 특별히 튜닝하거나 디버깅할 때만 주석을 해제해서 사용하세요.
#
# The values below already have defaults in code.
# Uncomment them only when tuning or debugging.
# ============================================================

#   Applio 설치 위치를 직접 지정할 때 사용합니다.
#   비우면 vendor/Applio 등을 자동 탐색합니다.
#   Optional custom Applio install path.
#   Leave empty to auto-detect vendor/Applio and related paths.
# APPLIO_DIR=


#   RVC inference
#   RVC 추론

#   RVC 추론 피치 추출 방식입니다. 노래 변환에는 rmvpe가 안정적인 기본값입니다.
#   RVC inference pitch extraction method. rmvpe is the stable default for singing conversion.
# RVC_INFER_F0_METHOD=rmvpe

#   RVC 인덱스 반영 비율입니다.
#   높을수록 모델 목소리 색이 강해지지만 깨질 수 있습니다.
#   RVC index blend rate.
#   Higher values make the target voice stronger but can add artifacts.
# RVC_INFER_INDEX_RATE=0.25

#   원본 보컬의 볼륨 움직임을 얼마나 따라갈지 정합니다.
#   Controls how much the converted vocal follows the source vocal volume envelope.
# RVC_INFER_VOLUME_ENVELOPE=0.75

#   무성음/자음 보호 값입니다.
#   높을수록 발음 보존이 안정적이고, 낮을수록 변환이 강해집니다.
#   Voiceless consonant protection.
#   Higher is more stable; lower makes conversion stronger.
# RVC_INFER_PROTECT=0.50


#   AI cover filters
#   AI 커버 필터

#   RVC 변환 전에 보컬 소스를 정리하는 FFmpeg 필터입니다.
#   off, false, none 중 하나로 끄기 가능합니다.
#   FFmpeg filter applied before RVC conversion.
#   Use off, false, or none to disable it.
# AI_COVER_INPUT_VOCAL_FILTER=none

#   RVC 변환 후 보컬을 정리하는 FFmpeg 필터입니다.
#   off, false, none 중 하나로 끄기 가능합니다.
#   FFmpeg filter applied after RVC conversion.
#   Use off, false, or none to disable it.
# AI_COVER_OUTPUT_VOCAL_FILTER=none


#   AI duet singer separation
#   AI 듀엣 가수 분리

#   AI 듀엣에서 두 가수 보컬을 나누는 백엔드입니다.
#   기본값 pyannote는 PyAnnote Audio 공식 모델로 누가 부르는 구간인지 찾은 뒤
#   시간표대로 잘라냅니다. Hugging Face 로그인/동의가 필요할 수 있습니다.
#   local_diarization은 로그인/토큰 없이 보컬 특징을 2명으로 클러스터링합니다.
#   local_diarization은 직접 선택했을 때만 사용됩니다.
#   Backend for splitting duet vocals into two singers.
#   Default pyannote cuts vocals by the official PyAnnote Audio speaker timeline
#   and may require Hugging Face login/terms.
#   local_diarization clusters vocal features into two singers without login/token.
#   local_diarization is used only when explicitly selected.
# MULTI_SINGER_SEPARATOR_BACKEND=pyannote

#   로그인 없는 로컬 시간표 분리 설정입니다.
#   이 방식은 직접 선택했을 때만 사용됩니다.
#   Local no-login diarization settings.
#   This is used only when explicitly selected.
# LOCAL_DIARIZATION_MIN_SEGMENT_SECONDS=0.35
# LOCAL_DIARIZATION_MERGE_GAP_SECONDS=0.45
# LOCAL_DIARIZATION_SEGMENT_PADDING_SECONDS=0.08
# LOCAL_DIARIZATION_SEGMENT_FADE_SECONDS=0.025

#   PyAnnote Audio diarization 모델명입니다.
#   이 모델은 Hugging Face에서 사용 조건 동의와 토큰이 필요할 수 있습니다.
#   PyAnnote Audio diarization model name.
#   This model may require accepting Hugging Face terms and using an access token.
# PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

#   PyAnnote/Hugging Face 토큰입니다. 비워 두면 HF_TOKEN 또는 HUGGINGFACE_TOKEN도 확인합니다.
#   huggingface-cli login으로 로그인한 캐시가 있으면 비워 둬도 됩니다.
#   PyAnnote/Hugging Face token. If empty, HF_TOKEN or HUGGINGFACE_TOKEN is also checked.
#   You can leave this empty when huggingface-cli login has already cached credentials.
# PYANNOTE_AUTH_TOKEN=

#   PyAnnote 실행 디바이스입니다. 비우면 CUDA 가능 여부를 자동 판단합니다.
#   PyAnnote execution device. Leave empty to auto-select CUDA when available.
# PYANNOTE_DEVICE=cuda

#   PyAnnote 시간표를 자를 때 앞뒤로 살짝 포함할 길이와 fade 길이입니다.
#   Padding/fade used when cutting vocals by PyAnnote timestamps.
# PYANNOTE_SEGMENT_PADDING_SECONDS=0.08
# PYANNOTE_SEGMENT_FADE_SECONDS=0.025

#   피치 정보를 이용해 듀엣 파트 번호를 안정적으로 정렬합니다.
#   기본 mode=order는 가수 구간 자체는 유지하고 1번/2번 순서만 정렬합니다.
#   mode=segment는 남녀 듀엣처럼 음역이 크게 다른 곡에서 구간 자체를 피치 기준으로 다시 나눕니다.
#   Use pitch information to stabilize duet part numbering.
#   Default mode=order keeps diarization labels and only orders part 1/2.
#   mode=segment relabels segments by pitch for strongly separated male/female-style duets.
# DUET_PITCH_REFINE=true
# DUET_PITCH_REFINE_MODE=order
# DUET_PITCH_PART_ORDER=low_first
# DUET_PITCH_MIN_CLUSTER_SEMITONES=3.0

#   AI 듀엣용 multi-singer 분리 모델명입니다.
#   PyAnnote/local 기본 모드에서는 필요하지 않습니다.
#   Asteroid/audio-separator 실험 백엔드를 쓸 때만 설정합니다.
#   Multi-singer separator model for AI duets.
#   Not needed for the default PyAnnote/local modes.
#   Set this only for Asteroid/audio-separator experimental backends.
# MULTI_SINGER_SEPARATOR_MODEL=Cyru5/MedleyVox

#   Hugging Face/Asteroid 방식 듀엣 분리 모델 실행 디바이스입니다.
#   비우면 CUDA 가능 여부를 자동 판단합니다.
#   Device for Hugging Face/Asteroid duet separation models.
#   Leave empty to auto-select CUDA when available.
# MULTI_SINGER_SEPARATOR_DEVICE=cuda

#   외부 듀엣 분리 스크립트 명령입니다.
#   {input}, {output_dir} 플레이스홀더를 사용할 수 있습니다.
#   External duet separator command.
#   You can use {input} and {output_dir} placeholders.
# MULTI_SINGER_SEPARATOR_COMMAND=

#   true로 설정하면 전용 듀엣 분리 모델/명령이 없을 때 로컬 시간표 분리로 전환하지 않고 실패합니다.
#   Set true to fail when no dedicated duet separator model/command is configured
#   instead of using local diarization.
# MULTI_SINGER_SEPARATOR_REQUIRE_MODEL=false


#   RVC training
#   RVC 학습

#   /train_voice RVC 학습 epoch 수입니다.
#   Number of RVC training epochs used by /train_voice.
# RVC_TRAIN_EPOCHS=300

#   /train_voice RVC 학습 batch size입니다.
#   RVC training batch size used by /train_voice.
# RVC_TRAIN_BATCH_SIZE=16

#   /train_voice 전처리/특징 추출에 사용할 최대 CPU 코어 수입니다.
#   Maximum CPU cores used for /train_voice preprocessing and feature extraction.
# RVC_TRAIN_CPU_CORES=12
